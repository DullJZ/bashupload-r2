# Cloudflare R2 配置 (通过 S3 API 访问)
# 在 Cloudflare 控制台中创建 R2 API Token 获取以下信息
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name

# 应用配置
# 最大上传大小（字节），默认 5GB
MAX_UPLOAD_SIZE=5368709120

# 文件最大保存时间（秒），默认 1 小时
MAX_AGE=3600

# 多次下载模式下的最大保存时间（秒），默认 24 小时
MAX_AGE_FOR_MULTIDOWNLOAD=86400

# 是否启用带有效期上传的内容去重（默认 true）
ENABLE_DEDUP=true

# 去重 HMAC 私钥；启用去重时必须配置。请使用至少 32 字节的随机值，且不要提交真实值
# 例如：openssl rand -hex 32
# DEDUP_SECRET=

# 上传密码保护（可选）
# PASSWORD=your_secure_password

# 短链接服务地址（可选）
SHORT_URL_SERVICE=https://suosuo.de/short

# 服务端口
PORT=3000

# Compose 停机时等待在途请求与 R2 操作完成的最长时间
# 应大于环境中最长上传/下载和清理操作的预期耗时
STOP_GRACE_PERIOD=11m

# 是否禁用定时清理任务（可选，默认 false）
NO_CLEANUP=false

# 上传限流：单 IP 每窗口最大上传次数（0 = 禁用，默认 10）
UPLOAD_RATE_LIMIT=10

# 上传限流窗口时长（秒，默认 60）
UPLOAD_RATE_LIMIT_WINDOW=60

# 是否信任代理头（X-Real-IP / X-Forwarded-For）识别客户端 IP
# 位于 nginx 等反向代理后时保持 true；直接暴露公网时设为 false 防伪造绕过限流
TRUST_PROXY_HEADERS=true
